# Copie para .env (na pasta core-deploy) e preencha. NUNCA commite o .env com valores reais.
# Este arquivo é lido pelo docker compose (interpolação de ${VAR} no docker-compose.yml).

# ============================================
# Domínios / TLS
# ============================================
# Os dois domínios devem ter registro DNS A apontando para o IP do VPS ANTES do primeiro start.
WEB_SERVICE_REST_DOMAIN=api.seudominio.com.br
WEB_APP_DOMAIN=app.seudominio.com.br
# E-mail usado no registro do certificado Let's Encrypt (avisos de expiração).
ACME_EMAIL=voce@seudominio.com.br

# Só usado com o overlay docker-compose.without-domain.yml (rodar sem domínio ainda).
# Deixe em branco para testar em localhost; no VPS sem DNS, coloque o IP público.
PUBLIC_HOST=

# Porta em que a API responde no modo sem domínio (o web fica sempre na 80).
# A mesma variável alimenta o bloco do Caddy, a publicação de porta do proxy e a URL embutida no
# front, então elas não têm como divergir. Trocar depois do build exige rebuild do web-app.
WEB_SERVICE_REST_PORT=8080

# ============================================
# PostgreSQL
# ============================================
POSTGRES_DB=core
POSTGRES_USER=core
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=TROQUE-ME

# ============================================
# JWT
# ============================================
# Gere com: openssl rand -base64 48   (mínimo 32 caracteres)
JWT_SIGNING_KEY=TROQUE-ME-CHAVE-FORTE-COM-NO-MINIMO-32-CARACTERES
JWT_ISSUER=Core.Api
JWT_AUDIENCE=Core.Client
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ============================================
# E-mail (SMTP) — usado no envio do PDF de orçamentos/pedidos
# ============================================
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME=Core
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_ENABLE_SSL=true

# ============================================
# GHCR (VPS só faz pull, build acontece fora daqui) — ver README seção 7
# ============================================
# Dono do pacote no GitHub Container Registry.
GHCR_OWNER=wilmarconsilva
# Versão da imagem a puxar (ex.: v1.4.0). Sem definir, cai em "latest".
IMAGE_TAG=

# ============================================
# Front-end (embutido no bundle em tempo de build)
# ============================================
# Vazio = o app detecta online/offline sozinho na inicialização (recomendado).
# Valores possíveis: online | offline
EXPO_PUBLIC_OPERATION_MODE=
